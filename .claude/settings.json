{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./mvnw *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(curl *)"
    ],
    "ask": [
      "Edit(./pom.xml)",
      "Edit(./*/pom.xml)",
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git rebase *)",
      "Bash(git filter-branch *)",
      "Edit(./AGENTS.md)",
      "Edit(./.claude/**)",
      "Edit(./.mvn/**)",
      "Edit(./verification/**)",
      "Edit(./**/ArchitectureTests.java)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-gate.sh",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowWrite": [
        "~/.m2/repository",
        "~/.m2/wrapper"
      ],
      "denyWrite": [
        "./.claude",
        "./AGENTS.md",
        "./.mvn",
        "./verification/src",
        "./verification/pom.xml"
      ]
    },
    "network": {
      "allowedDomains": [
        "repo.maven.apache.org",
        "repo1.maven.org",
        "repo.spring.io"
      ],
      "allowLocalBinding": true
    }
  }
}
