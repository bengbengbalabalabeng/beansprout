<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/>
	</parent>

	<groupId>dev.danvega</groupId>
	<artifactId>beansprout-parent</artifactId>
	<version>0.4.0</version>
	<packaging>pom</packaging>

	<name>Beansprout</name>
	<description>Add a Markdown blog to the Spring Boot app you already run.</description>
	<url>https://github.com/danvega/beansprout</url>

	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0</url>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>danvega</id>
			<name>Dan Vega</name>
			<url>https://www.danvega.dev</url>
		</developer>
	</developers>

	<scm>
		<url>https://github.com/danvega/beansprout</url>
		<connection>scm:git:https://github.com/danvega/beansprout.git</connection>
		<developerConnection>scm:git:git@github.com:danvega/beansprout.git</developerConnection>
		<tag>HEAD</tag>
	</scm>

	<issueManagement>
		<system>GitHub</system>
		<url>https://github.com/danvega/beansprout/issues</url>
	</issueManagement>

	<modules>
		<module>beansprout-core</module>
		<module>beansprout-spring-boot-autoconfigure</module>
		<module>beansprout-spring-boot-starter</module>
		<module>beansprout-mcp-spring-boot-starter</module>
		<module>themes/beansprout-theme-longhand</module>
		<module>themes/beansprout-theme-dateline</module>
		<module>themes/beansprout-theme-linocut</module>
		<module>themes/beansprout-theme-marginalia</module>
		<module>themes/beansprout-theme-small-machines</module>
		<module>themes/beansprout-theme-plainsong</module>
		<module>themes/beansprout-theme-onionskin</module>
		<module>themes/beansprout-theme-calling-card</module>
		<module>beansprout-bom</module>
		<module>beansprout-sample</module>
		<!-- Last on purpose: it reads the whole repo after every module has built and tested. -->
		<module>verification</module>
	</modules>

	<properties>
		<java.version>25</java.version>
		<!-- Keep in step with the parent version above. The annotation processors need it spelled out. -->
		<spring-boot-version>4.1.2</spring-boot-version>
		<jte.version>3.2.5</jte.version>
		<!-- The newest GA Spring AI, and the one that runs on Spring Boot 4.1 (specs/mcp.md). -->
		<spring-ai.version>2.0.2</spring-ai.version>
		<commonmark.version>0.29.0</commonmark.version>
		<archunit.version>1.5.1</archunit.version>
		<errorprone.version>2.52.0</errorprone.version>
		<nullaway.version>0.14.3</nullaway.version>
		<central-publishing.version>0.12.0</central-publishing.version>
		<maven-gpg.version>3.2.8</maven-gpg.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>dev.danvega</groupId>
				<artifactId>beansprout-core</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>dev.danvega</groupId>
				<artifactId>beansprout-spring-boot-autoconfigure</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>dev.danvega</groupId>
				<artifactId>beansprout-spring-boot-starter</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>dev.danvega</groupId>
				<artifactId>beansprout-mcp-spring-boot-starter</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>dev.danvega</groupId>
				<artifactId>beansprout-theme-longhand</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>gg.jte</groupId>
				<artifactId>jte-spring-boot-starter-4</artifactId>
				<version>${jte.version}</version>
			</dependency>
			<dependency>
				<groupId>gg.jte</groupId>
				<artifactId>jte-runtime</artifactId>
				<version>${jte.version}</version>
			</dependency>
			<dependency>
				<groupId>org.commonmark</groupId>
				<artifactId>commonmark</artifactId>
				<version>${commonmark.version}</version>
			</dependency>
			<dependency>
				<groupId>org.commonmark</groupId>
				<artifactId>commonmark-ext-gfm-tables</artifactId>
				<version>${commonmark.version}</version>
			</dependency>
			<dependency>
				<groupId>com.tngtech.archunit</groupId>
				<artifactId>archunit-junit5</artifactId>
				<version>${archunit.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<configuration>
						<!-- Temp files for @TempDir go under target/, so a sandboxed build can write them. -->
						<argLine>-Djava.io.tmpdir=${project.build.directory}</argLine>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<compilerArgs>
							<arg>-Xlint:all,-processing,-serial</arg>
							<arg>-Werror</arg>
							<!-- Error Prone with its default checks, plus NullAway as an error.
							     JSpecify's @Nullable and @NullMarked become compile errors. Tests are excluded from NullAway. -->
							<arg>-XDcompilePolicy=simple</arg>
							<arg>--should-stop=ifError=FLOW</arg>
							<arg>-Xplugin:ErrorProne -Xep:NullAway:ERROR -XepOpt:NullAway:JSpecifyMode=true -XepOpt:NullAway:AnnotatedPackages=dev.danvega.beansprout -XepExcludedPaths:.*/src/test/.*</arg>
						</compilerArgs>
						<annotationProcessorPaths>
							<path>
								<groupId>com.google.errorprone</groupId>
								<artifactId>error_prone_core</artifactId>
								<version>${errorprone.version}</version>
							</path>
							<path>
								<groupId>com.uber.nullaway</groupId>
								<artifactId>nullaway</artifactId>
								<version>${nullaway.version}</version>
							</path>
							<path>
								<groupId>org.springframework.boot</groupId>
								<artifactId>spring-boot-configuration-processor</artifactId>
								<version>${spring-boot-version}</version>
							</path>
							<path>
								<groupId>org.springframework.boot</groupId>
								<artifactId>spring-boot-autoconfigure-processor</artifactId>
								<version>${spring-boot-version}</version>
							</path>
						</annotationProcessorPaths>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>

		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>enforce-build-rules</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireJavaVersion>
									<version>[25,)</version>
									<message>Beansprout builds on JDK 25 or newer.</message>
								</requireJavaVersion>
								<requireMavenVersion>
									<version>[3.9,)</version>
								</requireMavenVersion>
								<banDuplicatePomDependencyVersions/>
								<bannedDependencies>
									<excludes>
										<exclude>org.projectlombok:lombok</exclude>
										<exclude>junit:junit</exclude>
										<exclude>log4j:log4j</exclude>
									</excludes>
									<message>Banned dependency. See "Dependencies" in AGENTS.md.</message>
								</bannedDependencies>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<!--
		The release build: sources and Javadoc jars, signatures, and the upload to Maven Central.
		.github/workflows/release.yml runs it when a v* tag is pushed. RELEASING.md has the steps.
		Try it locally without signing or uploading:
		  ./mvnw -P release -Dgpg.skip=true -DskipPublishing=true deploy
	-->
	<profiles>
		<profile>
			<id>release</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-source-plugin</artifactId>
						<executions>
							<execution>
								<id>attach-sources</id>
								<goals>
									<goal>jar-no-fork</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-javadoc-plugin</artifactId>
						<configuration>
							<doclint>all,-missing</doclint>
							<quiet>true</quiet>
						</configuration>
						<executions>
							<execution>
								<id>attach-javadocs</id>
								<goals>
									<goal>jar</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>${maven-gpg.version}</version>
						<configuration>
							<!-- The key and its passphrase come from the environment: MAVEN_GPG_KEY and
							     MAVEN_GPG_PASSPHRASE. No gpg agent or keyring needed. -->
							<bestPractices>true</bestPractices>
							<signer>bc</signer>
						</configuration>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<version>${central-publishing.version}</version>
						<extensions>true</extensions>
						<configuration>
							<publishingServerId>central</publishingServerId>
							<!-- The upload is checked by Central, then waits for a person to press
							     Publish at central.sonatype.com. Nothing goes live by itself. -->
							<autoPublish>false</autoPublish>
							<waitUntil>validated</waitUntil>
							<excludeArtifacts>
								<artifact>beansprout-sample</artifact>
								<artifact>beansprout-verification</artifact>
							</excludeArtifacts>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
