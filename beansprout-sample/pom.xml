<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>dev.danvega</groupId>
		<artifactId>beansprout-parent</artifactId>
		<version>0.4.0-SNAPSHOT</version>
	</parent>

	<artifactId>beansprout-sample</artifactId>
	<name>Beansprout Sample</name>
	<description>An ordinary Spring Boot app that adds the starter. The end-to-end tests run here.</description>

	<properties>
		<maven.deploy.skip>true</maven.deploy.skip>
		<maven.install.skip>true</maven.install.skip>
	</properties>

	<!-- The way an app gets Beansprout: import the BOM once, then add the starter and themes
	     with no version. The sample has every theme; application.yaml picks one. -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>dev.danvega</groupId>
				<artifactId>beansprout-bom</artifactId>
				<version>${project.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>dev.danvega</groupId>
			<artifactId>beansprout-spring-boot-starter</artifactId>
		</dependency>
		<dependency>
			<groupId>dev.danvega</groupId>
			<artifactId>beansprout-mcp-spring-boot-starter</artifactId>
		</dependency>
		<dependency>
			<groupId>dev.danvega</groupId>
			<artifactId>beansprout-theme-longhand</artifactId>
		</dependency>
		<dependency>
			<groupId>dev.danvega</groupId>
			<artifactId>beansprout-theme-dateline</artifactId>
		</dependency>
		<dependency>
			<groupId>dev.danvega</groupId>
			<artifactId>beansprout-theme-linocut</artifactId>
		</dependency>
		<dependency>
			<groupId>dev.danvega</groupId>
			<artifactId>beansprout-theme-marginalia</artifactId>
		</dependency>
		<dependency>
			<groupId>dev.danvega</groupId>
			<artifactId>beansprout-theme-small-machines</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>gg.jte</groupId>
			<artifactId>jte-spring-boot-starter-4</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
