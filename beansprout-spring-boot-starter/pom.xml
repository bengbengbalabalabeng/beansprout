<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>dev.danvega</groupId>
		<artifactId>beansprout-parent</artifactId>
		<version>0.2.0-SNAPSHOT</version>
	</parent>

	<artifactId>beansprout-spring-boot-starter</artifactId>
	<name>Beansprout Starter</name>
	<description>The one dependency an app adds to get a blog.</description>

	<!-- A starter has no code. It only pulls in what an app needs. -->
	<dependencies>
		<dependency>
			<groupId>dev.danvega</groupId>
			<artifactId>beansprout-spring-boot-autoconfigure</artifactId>
		</dependency>
	</dependencies>

	<profiles>
		<!-- Maven Central wants sources and Javadoc jars for every jar. With no code there are
		     none to build, so both carry a README that says where the code is. -->
		<profile>
			<id>release</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-jar-plugin</artifactId>
						<executions>
							<execution>
								<id>placeholder-sources</id>
								<phase>package</phase>
								<goals>
									<goal>jar</goal>
								</goals>
								<configuration>
									<classifier>sources</classifier>
									<classesDirectory>${project.basedir}/src/release</classesDirectory>
								</configuration>
							</execution>
							<execution>
								<id>placeholder-javadoc</id>
								<phase>package</phase>
								<goals>
									<goal>jar</goal>
								</goals>
								<configuration>
									<classifier>javadoc</classifier>
									<classesDirectory>${project.basedir}/src/release</classesDirectory>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
