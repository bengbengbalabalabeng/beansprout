<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>dev.danvega</groupId>
		<artifactId>beansprout-parent</artifactId>
		<version>0.4.0</version>
	</parent>

	<artifactId>beansprout-core</artifactId>
	<name>Beansprout Core</name>
	<description>Posts, tags and the view model. No web, no template engine.</description>

	<dependencies>
		<dependency>
			<groupId>org.jspecify</groupId>
			<artifactId>jspecify</artifactId>
		</dependency>
		<dependency>
			<groupId>org.commonmark</groupId>
			<artifactId>commonmark</artifactId>
		</dependency>
		<dependency>
			<groupId>org.commonmark</groupId>
			<artifactId>commonmark-ext-gfm-tables</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>core-stays-plain</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<bannedDependencies>
									<excludes>
										<exclude>org.springframework.boot:*:*:*:compile</exclude>
										<exclude>org.springframework.boot:*:*:*:runtime</exclude>
										<exclude>org.springframework:spring-web*:*:*:compile</exclude>
										<exclude>jakarta.servlet:*:*:*:compile</exclude>
										<exclude>gg.jte:*:*:*:compile</exclude>
										<exclude>org.thymeleaf:*:*:*:compile</exclude>
										<exclude>org.freemarker:*:*:*:compile</exclude>
									</excludes>
									<message>beansprout-core has no web, no Spring Boot and no template engine. See "Modules" in AGENTS.md.</message>
								</bannedDependencies>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
