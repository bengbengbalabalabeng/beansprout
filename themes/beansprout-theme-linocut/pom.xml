<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>dev.danvega</groupId>
		<artifactId>beansprout-parent</artifactId>
		<version>0.5.0-SNAPSHOT</version>
		<relativePath>../../pom.xml</relativePath>
	</parent>

	<artifactId>beansprout-theme-linocut</artifactId>
	<name>Beansprout Theme: Linocut</name>
	<description>Linocut, a bold and playful Beansprout theme: black ink on warm paper with one red. JTE templates, compiled ahead of time, and their stylesheet.</description>

	<properties>
		<!-- The package the compiled templates live in. Beansprout finds it through LinocutTheme.
		     It must not hold any other class: the precompile step empties it first. -->
		<linocut.package>dev.danvega.beansprout.engine.jte.linocut.templates</linocut.package>
	</properties>

	<dependencies>
		<dependency>
			<groupId>dev.danvega</groupId>
			<artifactId>beansprout-core</artifactId>
		</dependency>
		<dependency>
			<groupId>gg.jte</groupId>
			<artifactId>jte-runtime</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>gg.jte</groupId>
				<artifactId>jte-maven-plugin</artifactId>
				<version>${jte.version}</version>
				<executions>
					<execution>
						<id>precompile-templates</id>
						<phase>process-classes</phase>
						<goals>
							<goal>precompile</goal>
						</goals>
						<configuration>
							<sourceDirectory>${project.basedir}/src/main/jte</sourceDirectory>
							<targetDirectory>${project.build.outputDirectory}</targetDirectory>
							<packageName>${linocut.package}</packageName>
							<contentType>Html</contentType>
							<trimControlStructures>true</trimControlStructures>
							<compileArgs>
								<compileArg>--release</compileArg>
								<compileArg>${java.version}</compileArg>
							</compileArgs>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
